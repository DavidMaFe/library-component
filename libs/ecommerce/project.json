{
  "name": "ecommerce",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ecommerce/src",
  "prefix": "lc",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:ecommerce"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/ecommerce/ng-package.json",
        "tsConfig": "libs/ecommerce/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ecommerce/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/ecommerce/jest.config.cts",
        "tsConfig": "libs/ecommerce/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/ecommerce/.storybook",
        "browserTarget": "ecommerce:build-storybook",
        "compodoc": false,
        "styles": [
          "@fontsource-variable/bricolage-grotesque/opsz.css",
          "@fontsource-variable/instrument-sans/index.css",
          "@fontsource-variable/geist-mono/index.css",
          "libs/ecommerce/.storybook/styles.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ecommerce",
        "configDir": "libs/ecommerce/.storybook",
        "browserTarget": "ecommerce:build-storybook",
        "compodoc": false,
        "styles": [
          "@fontsource-variable/bricolage-grotesque/opsz.css",
          "@fontsource-variable/instrument-sans/index.css",
          "@fontsource-variable/geist-mono/index.css",
          "libs/ecommerce/.storybook/styles.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
